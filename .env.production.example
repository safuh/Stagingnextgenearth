# Copy to .env for the production Compose stack and replace every placeholder.
APP_NAME=NextGenForEarth
APP_VERSION=0.1.0
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://app:replace-db-password@postgres.internal:5432/nextgen
JWT_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
WEB_PORT=3000
LOG_LEVEL=INFO
CORS_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=false
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
MALWARE_SCANNING_ENABLED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
DATASET_SCANNER_BATCH_SIZE=10
DATASET_SCANNER_POLL_INTERVAL_SECONDS=5
