# Dedicated staging environment. Copy to .env.staging and replace every placeholder.
APP_NAME=NextGenForEarth-Staging
APP_VERSION=staging
PUBLIC_BASE_URL=https://staging.nextgenforearth.org
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://nextgen_staging:replace-with-unique-db-password@postgres-staging.internal:5432/nextgen_staging
JWT_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
AUTH_RATE_LIMIT_REQUESTS=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_CLIMATE_RATE_LIMIT_REQUESTS=60
PUBLIC_CLIMATE_RATE_LIMIT_WINDOW_SECONDS=60
WEB_PORT=3000
LOG_LEVEL=INFO
CORS_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=false
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
MALWARE_SCANNING_ENABLED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
DATASET_SCANNER_BATCH_SIZE=10
DATASET_SCANNER_POLL_INTERVAL_SECONDS=5
# Keep ODK profile disabled until staging has its own non-production Central project.
ODK_ENCRYPTION_KEY=replace-with-generated-fernet-key
ODK_TLS_VERIFY=true
