APP_NAME=Stagingnextgenearth
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
DATABASE_URL=sqlite+aiosqlite:///./backbone.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
LOG_LEVEL=INFO
LOG_JSON=false
# Generate a unique high-entropy secret for every environment.
# JWT_SECRET_KEY=replace-with-a-unique-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Optional malware scanning; requires OBJECT_STORAGE_ENABLED=true and ClamAV.
MALWARE_SCANNING_ENABLED=false
# CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
