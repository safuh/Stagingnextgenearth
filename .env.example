APP_NAME=Stagingnextgenearth
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
PUBLIC_BASE_URL=http://localhost:3000
POSTGRES_DB=nextgenearth
POSTGRES_USER=nextgenearth
POSTGRES_PASSWORD=replace-with-a-local-url-safe-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nextgenearth:replace-with-a-local-url-safe-password@127.0.0.1:5432/nextgenearth
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
LOG_LEVEL=INFO
LOG_JSON=false
# Generate a unique high-entropy secret for every environment.
JWT_SECRET_KEY=replace-with-a-unique-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
AUTH_RATE_LIMIT_REQUESTS=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_CLIMATE_RATE_LIMIT_REQUESTS=60
PUBLIC_CLIMATE_RATE_LIMIT_WINDOW_SECONDS=60
# Optional malware scanning; requires OBJECT_STORAGE_ENABLED=true and ClamAV.
MALWARE_SCANNING_ENABLED=false
# CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# Web BFF host port for docker/compose.production.yml.
WEB_PORT=3000

# Optional Fernet key for encrypting saved ODK Central passwords.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ODK_ENCRYPTION_KEY=
# Keep true by default. Set false only for a self-signed local Central host.
ODK_TLS_VERIFY=true
